# ── Produção (Vercel) e desenvolvimento apontando para o D1 real ──
# ID da conta Cloudflare (painel → Workers & Pages → lado direito)
CLOUDFLARE_ACCOUNT_ID=
# ID do banco D1 "nuvox-crm"
CLOUDFLARE_D1_DATABASE_ID=
# Token de API com permissão "Account → D1 → Edit"
CLOUDFLARE_API_TOKEN=
# Segredo para assinar o cookie de sessão (gere com: openssl rand -hex 32)
SESSION_SECRET=

# ── Desenvolvimento local sem Cloudflare (opcional) ──
# Se preenchido, a API usa um arquivo SQLite local em vez do D1.
# Crie com: npm run db:local
# DB_LOCAL=.dev-db/nuvox.sqlite
